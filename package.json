{
  "name": "translator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted English → Hungarian look-up web app for your phone, powered by OpenRouter.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json",
    "icons": "bash scripts/make-icons.sh"
  },
  "dependencies": {
    "dompurify": "^3.4.18",
    "express": "^5.3.0",
    "marked": "^18.2.0",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.11.0",
    "tsx": "^4.20.6",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
